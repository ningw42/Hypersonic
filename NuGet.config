<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="CHTCHSConv" />
      <package pattern="CommunityToolkit.*" />
      <package pattern="coverlet.*" />
      <package pattern="H.*" />
      <package pattern="Lyricify.*" />
      <package pattern="Microsoft.*" />
      <package pattern="MSTest*" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="SharpZipLib" />
      <package pattern="SQLitePCLRaw.*" />
      <package pattern="System.*" />
      <package pattern="WinUIEx" />
    </packageSource>
  </packageSourceMapping>
</configuration>
