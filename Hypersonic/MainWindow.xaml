<windowex:WindowEx
    x:Class="Hypersonic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hypersonic"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    MinWidth="500"
    MinHeight="500"
    mc:Ignorable="d">
    <!--  Window size/position/maximized persistence is owned by AppStateService (AppState.json
          WindowState) + ActivationService.RestoreWindowState(). WinUIEx's PersistenceId is
          intentionally NOT set: it would restore its own WINDOWPLACEMENT on the first WM_SHOWWINDOW
          (during Activate, after our manual restore) and silently override it.  -->
</windowex:WindowEx>
