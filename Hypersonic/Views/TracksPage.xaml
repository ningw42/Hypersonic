<Page
    x:Class="Hypersonic.Views.TracksPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Hypersonic.Models"
    xmlns:controls="using:Hypersonic.Controls"
    xmlns:behaviors="using:Hypersonic.Behaviors"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SecondaryBrushProvider" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
        <TextBlock x:Name="TertiaryBrushProvider" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed"/>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Uid="Tracks_Title"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     x:Name="SearchBox"
                     PlaceholderText="Search tracks..."
                     VerticalAlignment="Center"
                     Margin="16,0,8,0"
                     Width="300"
                     HorizontalAlignment="Right"
                     TextChanged="SearchBox_TextChanged"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{x:Bind ViewModel.SortOptions}"
                      SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      MinWidth="130"/>

            <Button Grid.Column="3"
                    Command="{x:Bind ViewModel.ToggleSortOrderCommand}"
                    IsEnabled="{x:Bind ViewModel.IsSortOrderSupported, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Width="32" Height="32" Padding="0"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SortOrderTooltip, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind ViewModel.SortOrderGlyph, Mode=OneWay}" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Error message -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 Margin="0,0,0,8"/>

        <!-- Track list column headers -->
        <Grid Grid.Row="2"
              ColumnSpacing="12"
              Padding="12,8,28,4"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="#"
                       HorizontalAlignment="Right"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1"
                       Text="Title"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2"
                       Text="Album"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3"
                       Text="Artist"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4"
                       Text="Duration"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5"
                       Text="Codec"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6"
                       Text="Bitrate"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="7"
                       Text="Plays"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <TextBlock Grid.Column="8"
                       Text="BPM"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"/>
            <FontIcon Grid.Column="9"
                      Glyph="&#xEB51;"
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center"/>
        </Grid>

        <!-- Track list -->
        <ListView Grid.Row="3"
                  x:Name="TrackListView"
                  ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="TrackList_ItemClick"
                  Padding="0,0,16,24">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,2"/>
                    <Setter Property="MinHeight" Value="36"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SongInfo">
                    <Grid ColumnSpacing="12" Padding="0,6"
                          Background="{x:Bind IsNowPlaying, Mode=OneWay, Converter={StaticResource BoolToHighlightBrushConverter}}"
                          CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <!-- Position # / Equalizer -->
                        <Grid Grid.Column="0" Width="56">
                            <controls:EqualizerBars
                                       HorizontalAlignment="Left"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       IsAnimating="{x:Bind IsPlaying, Mode=OneWay}"
                                       Visibility="{x:Bind IsNowPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="{x:Bind PositionNumber}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <!-- Title -->
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Title}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1"
                                   VerticalAlignment="Center"
                                   FontWeight="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"
                                   ToolTipService.ToolTip="{x:Bind Title}"/>

                        <!-- Album -->
                        <RichTextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       IsTextSelectionEnabled="False"
                                       DataContextChanged="AlbumLink_DataContextChanged"/>

                        <!-- Artist -->
                        <RichTextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       IsTextSelectionEnabled="False"
                                       DataContextChanged="ArtistLinks_DataContextChanged"/>

                        <!-- Duration -->
                        <TextBlock Grid.Column="4"
                                   Text="{x:Bind Duration, Converter={StaticResource SecondsToTimeConverter}}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Codec -->
                        <TextBlock Grid.Column="5"
                                   Text="{x:Bind Suffix}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Bitrate -->
                        <TextBlock Grid.Column="6"
                                   Text="{x:Bind BitRateDisplay}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Play count -->
                        <TextBlock Grid.Column="7"
                                   Text="{x:Bind PlayCount}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- BPM -->
                        <TextBlock Grid.Column="8"
                                   Text="{x:Bind BPMDisplay}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <!-- Favorite -->
                        <ToggleButton Grid.Column="9"
                                      IsChecked="{x:Bind IsStarred, Mode=OneWay}"
                                      Padding="0"
                                      Width="32" Height="32"
                                      VerticalAlignment="Center"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      Style="{StaticResource FavoriteToggleButtonStyle}"
                                      Command="{Binding ViewModel.ToggleStarCommand, ElementName=PageRoot}"
                                      CommandParameter="{x:Bind}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <FontIcon Glyph="&#xE142;"
                      FontSize="48"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Loading indicator -->
        <ProgressRing Grid.Row="3"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="40" Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Page>
