<Page
    x:Class="Hypersonic.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Hypersonic.Helpers"
    xmlns:behaviors="using:Hypersonic.Behaviors"
    xmlns:converters="using:Hypersonic.Converters"
    xmlns:models="using:Hypersonic.Models"
    xmlns:coremodels="using:Hypersonic.Core.Models"
    xmlns:controls="using:Hypersonic.Controls"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    Loaded="OnLoaded">

    <Page.Resources>
        <converters:SecondsToTimeConverter x:Key="SecondsToTimeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:BoolToHighlightBrushConverter x:Key="BoolToHighlightBrushConverter"/>
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main navigation area -->
        <Grid Grid.Row="0">
            <Grid x:Name="AppTitleBar"
                  Canvas.ZIndex="1"
                  Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
                  IsHitTestVisible="True"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- Icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/WindowIcon.ico" Width="16" Height="16" Margin="8,0,8,0"/>
                    <TextBlock x:Name="AppTitleBarText"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                </StackPanel>

                <!-- Search box -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="TitleBarSearchBox"
                             PlaceholderText="Search (Ctrl+K)"
                             MaxWidth="600"
                             MinWidth="300"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"
                             KeyDown="SearchBox_KeyDown"/>

                    <Popup x:Name="SearchResultsPopup"
                           IsLightDismissEnabled="False">
                        <Border x:Name="SearchPopupBorder"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                Width="800">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Artists column -->
                                <StackPanel Grid.Column="0" Padding="8,4"
                                            Visibility="{x:Bind ViewModel.HasArtistResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Artists" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,8"/>
                                    <ListView ItemsSource="{x:Bind ViewModel.ArtistResults, Mode=OneWay}"
                                              IsItemClickEnabled="True"
                                              ItemClick="SearchResult_ItemClick"
                                              SelectionMode="None"
                                              MaxHeight="300">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="coremodels:SearchSuggestionItem">
                                                <Grid Padding="2,4" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="32" Height="32" CornerRadius="16">
                                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="16">
                                                            <FontIcon Glyph="&#xE77B;" FontSize="14"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" Width="32" Height="32"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <controls:MarqueeTextBlock Text="{x:Bind PrimaryText}" FontSize="13"/>
                                                        <controls:MarqueeTextBlock Text="{x:Bind SecondaryText}" FontSize="11"
                                                                                   FontWeight="Light"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <!-- Separator 1 -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Margin="0,8"
                                        Visibility="{x:Bind ViewModel.HasArtistResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Albums column -->
                                <StackPanel Grid.Column="2" Padding="8,4"
                                            Visibility="{x:Bind ViewModel.HasAlbumResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Albums" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,8"/>
                                    <ListView ItemsSource="{x:Bind ViewModel.AlbumResults, Mode=OneWay}"
                                              IsItemClickEnabled="True"
                                              ItemClick="SearchResult_ItemClick"
                                              SelectionMode="None"
                                              MaxHeight="300">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="coremodels:SearchSuggestionItem">
                                                <Grid Padding="2,4" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="32" Height="32">
                                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="2">
                                                            <FontIcon Glyph="&#xE93C;" FontSize="14"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" Width="32" Height="32"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <controls:MarqueeTextBlock Text="{x:Bind PrimaryText}" FontSize="13"/>
                                                        <controls:MarqueeTextBlock Text="{x:Bind SecondaryText}" FontSize="11"
                                                                                   FontWeight="Light"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <!-- Separator 2 -->
                                <Border Grid.Column="3" Width="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Margin="0,8"
                                        Visibility="{x:Bind ViewModel.HasAlbumResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Songs column -->
                                <StackPanel Grid.Column="4" Padding="8,4"
                                            Visibility="{x:Bind ViewModel.HasSongResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Songs" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,8"/>
                                    <ListView ItemsSource="{x:Bind ViewModel.SongResults, Mode=OneWay}"
                                              IsItemClickEnabled="True"
                                              ItemClick="SearchResult_ItemClick"
                                              SelectionMode="None"
                                              MaxHeight="300">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="coremodels:SearchSuggestionItem">
                                                <Grid Padding="2,4" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="32" Height="32">
                                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="2">
                                                            <FontIcon Glyph="&#xE8D6;" FontSize="14"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" Width="32" Height="32"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <controls:MarqueeTextBlock Text="{x:Bind PrimaryText}" FontSize="13"/>
                                                        <controls:MarqueeTextBlock Text="{x:Bind SecondaryText}" FontSize="11"
                                                                                   FontWeight="Light"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
            <NavigationView
                x:Name="NavigationViewControl"
                Canvas.ZIndex="0"
                IsBackButtonVisible="Visible"
                IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
                IsSettingsVisible="True"
                IsPaneOpen="False"
                ExpandedModeThresholdWidth="1280"
                DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
                Header="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Uid="Shell_Main" helpers:NavigationHelper.NavigateTo="Hypersonic.ViewModels.MainViewModel">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Shell_Albums" helpers:NavigationHelper.NavigateTo="Hypersonic.ViewModels.AlbumsViewModel">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE93C;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Shell_Artists" helpers:NavigationHelper.NavigateTo="Hypersonic.ViewModels.ArtistsViewModel">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE77B;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Shell_Playlists" helpers:NavigationHelper.NavigateTo="Hypersonic.ViewModels.PlaylistsViewModel">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8FD;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock
                                Text="{Binding}"
                                Style="{ThemeResource TitleTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </NavigationView.HeaderTemplate>
                <i:Interaction.Behaviors>
                    <behaviors:NavigationViewHeaderBehavior
                        DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                        <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        Text="{Binding}"
                                        Style="{ThemeResource TitleTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                    </behaviors:NavigationViewHeaderBehavior>
                </i:Interaction.Behaviors>
                <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                    <Frame x:Name="NavigationFrame" />
                </Grid>
            </NavigationView>
        </Grid>

        <!-- Player Bar -->
        <Grid Grid.Row="1"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="16,8"
              x:Name="PlayerBar">

            <Popup x:Name="QueuePopup" IsLightDismissEnabled="True">
                <Border x:Name="QueuePopupBorder"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="0"
                        Width="400" MaxHeight="500">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Padding="16,12,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Title + count -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Queue" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{x:Bind Player.QueueCountText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Shuffle + Repeat -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                                <Button Command="{x:Bind Player.ToggleShuffleCommand}"
                                        Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="12"
                                              Foreground="{x:Bind Player.ShuffleEnabled, Mode=OneWay,
                                                           Converter={StaticResource BoolToAccentBrushConverter}}"/>
                                </Button>
                                <Button Command="{x:Bind Player.CycleRepeatModeCommand}"
                                        Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Player.RepeatMode, Mode=OneWay,
                                                      Converter={StaticResource RepeatModeGlyphConverter}}"
                                              FontSize="12"
                                              Foreground="{x:Bind Player.RepeatMode, Mode=OneWay,
                                                           Converter={StaticResource RepeatModeToAccentBrushConverter}}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Track list -->
                        <ListView x:Name="QueueListView" Grid.Row="1"
                                  ItemsSource="{x:Bind Player.QueueItems, Mode=OneWay}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  Padding="4,0,4,4"
                                  MaxHeight="440"
                                  DoubleTapped="QueueList_DoubleTapped"
                                  Visibility="{x:Bind Player.IsQueueEmpty, Mode=OneWay,
                                               Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="CornerRadius" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:QueueItem">
                                    <Grid Padding="8,4" ColumnSpacing="10" Height="40"
                                          Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToHighlightBrushConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover art -->
                                        <Grid Grid.Column="0" Width="32" Height="32" CornerRadius="2">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="2">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="14"
                                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding Track.CoverArtUri}" Stretch="UniformToFill"
                                                   Width="32" Height="32"/>
                                        </Grid>

                                        <!-- Track info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{x:Bind Track.Title}" FontSize="13" MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"/>
                                            <TextBlock FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{Binding Track.Artist}"/>
                                                <Run Text=" &#x2014; " Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <Run Text="{Binding Track.Album}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Track.Duration, Converter={StaticResource SecondsToTimeConverter}}"
                                                   FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty state -->
                        <TextBlock Grid.Row="1"
                                   Text="Queue is empty"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="13" Margin="0,40"
                                   Visibility="{x:Bind Player.IsQueueEmpty, Mode=OneWay,
                                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Popup>
            <Grid Height="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cover art -->
                <Grid Grid.Column="0" Width="48" Height="48" CornerRadius="4" Margin="0,0,12,0">
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                        <FontIcon Glyph="&#xE8D6;" FontSize="20"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image x:Name="PlayerCoverArt"
                           Stretch="UniformToFill" Width="48" Height="48"/>
                </Grid>

                <!-- Track info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{x:Bind Player.TrackTitle, Mode=OneWay}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <HyperlinkButton Command="{x:Bind Player.NavigateToArtistCommand}"
                                     Padding="0" Margin="0,-2,0,-2" MinHeight="0" MinWidth="0">
                        <TextBlock Text="{x:Bind Player.ArtistName, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </HyperlinkButton>
                    <HyperlinkButton Command="{x:Bind Player.NavigateToAlbumCommand}"
                                     Padding="0" Margin="0,-2,0,0" MinHeight="0" MinWidth="0">
                        <TextBlock Text="{x:Bind Player.AlbumName, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </HyperlinkButton>
                </StackPanel>

                <!-- Controls + progress -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{x:Bind Player.ToggleShuffleCommand}"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14"
                                  Foreground="{x:Bind Player.ShuffleEnabled, Mode=OneWay,
                                               Converter={StaticResource BoolToAccentBrushConverter}}"/>
                    </Button>

                    <Button Grid.Column="1" Command="{x:Bind Player.PreviousCommand}"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE892;" FontSize="14"/>
                    </Button>
                    <Button Grid.Column="2" x:Name="PlayPauseButton" Command="{x:Bind Player.PlayPauseCommand}"
                            Width="36" Height="36" Padding="0" CornerRadius="18" VerticalAlignment="Center">
                        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16"/>
                    </Button>
                    <Button Grid.Column="3" Command="{x:Bind Player.NextCommand}"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            Margin="0,0,0,0">
                        <FontIcon Glyph="&#xE893;" FontSize="14"/>
                    </Button>

                    <Button Grid.Column="4"
                            Command="{x:Bind Player.CycleRepeatModeCommand}"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <FontIcon Glyph="{x:Bind Player.RepeatMode, Mode=OneWay,
                                          Converter={StaticResource RepeatModeGlyphConverter}}"
                                  FontSize="14"
                                  Foreground="{x:Bind Player.RepeatMode, Mode=OneWay,
                                               Converter={StaticResource RepeatModeToAccentBrushConverter}}"/>
                    </Button>

                    <TextBlock Grid.Column="5" Text="{x:Bind Player.PositionText, Mode=OneWay}"
                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Width="36" TextAlignment="Right" Margin="0,0,8,0"/>

                    <Slider Grid.Column="6" Minimum="0"
                            Maximum="{x:Bind Player.Duration, Mode=OneWay}"
                            Value="{x:Bind Player.Position, Mode=TwoWay}"
                            ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                            VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="7" Text="{x:Bind Player.DurationText, Mode=OneWay}"
                               FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Width="36" Margin="8,0,0,0"/>

                    <ToggleButton x:Name="QueueToggleButton" Grid.Column="8"
                            IsChecked="{x:Bind Player.IsQueueOpen, Mode=TwoWay}"
                            Style="{StaticResource TransparentToggleButtonStyle}"
                            Width="32" Height="32" Padding="0" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEA37;" FontSize="14"
                                  Foreground="{x:Bind Player.IsQueueOpen, Mode=OneWay,
                                               Converter={StaticResource BoolToAccentBrushConverter}}"/>
                    </ToggleButton>
                </Grid>

                <!-- Volume -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Margin="16,0,0,0">
                    <Button Command="{x:Bind Player.ToggleMuteCommand}"
                            Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind Player.VolumeGlyph, Mode=OneWay}" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <Slider Width="100" Minimum="0" Maximum="100" StepFrequency="1"
                            Value="{x:Bind Player.VolumePercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
