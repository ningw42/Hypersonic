<Page
    x:Class="Hypersonic.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:Hypersonic.Helpers"
    xmlns:behaviors="using:Hypersonic.Behaviors"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main navigation area -->
        <Grid Grid.Row="0">
            <Grid x:Name="AppTitleBar"
                  Canvas.ZIndex="1"
                  Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
                  IsHitTestVisible="True"
                  VerticalAlignment="Top">
                <Image Source="/Assets/WindowIcon.ico"
                       HorizontalAlignment="Left"
                       Width="16"
                       Height="16" />
                <TextBlock x:Name="AppTitleBarText"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="28,0,0,0"/>
            </Grid>
            <NavigationView
                x:Name="NavigationViewControl"
                Canvas.ZIndex="0"
                IsBackButtonVisible="Visible"
                IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
                IsSettingsVisible="True"
                ExpandedModeThresholdWidth="1280"
                DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
                Header="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Uid="Shell_Main" helpers:NavigationHelper.NavigateTo="Hypersonic.ViewModels.MainViewModel">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7C3;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Uid="Shell_Albums" helpers:NavigationHelper.NavigateTo="Hypersonic.ViewModels.AlbumsViewModel">
                        <NavigationViewItem.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE93C;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.HeaderTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock
                                Text="{Binding}"
                                Style="{ThemeResource TitleTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </NavigationView.HeaderTemplate>
                <i:Interaction.Behaviors>
                    <behaviors:NavigationViewHeaderBehavior
                        DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                        <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        Text="{Binding}"
                                        Style="{ThemeResource TitleTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                    </behaviors:NavigationViewHeaderBehavior>
                </i:Interaction.Behaviors>
                <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                    <Frame x:Name="NavigationFrame" />
                </Grid>
            </NavigationView>
        </Grid>

        <!-- Player Bar -->
        <Grid Grid.Row="1"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="16,8"
              x:Name="PlayerBar"
              x:Load="{x:Bind Player.HasTrack, Mode=OneWay}">
            <Grid Height="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cover art -->
                <Grid Grid.Column="0" Width="48" Height="48" CornerRadius="4" Margin="0,0,12,0">
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                        <FontIcon Glyph="&#xE8D6;" FontSize="20"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image x:Name="PlayerCoverArt"
                           Stretch="UniformToFill" Width="48" Height="48"/>
                </Grid>

                <!-- Track info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{x:Bind Player.TrackTitle, Mode=OneWay}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <TextBlock Text="{x:Bind Player.ArtistName, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>

                <!-- Controls + progress -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Button Command="{x:Bind Player.PreviousCommand}"
                                Width="36" Height="36" Padding="0"
                                Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE892;" FontSize="14"/>
                        </Button>
                        <Button x:Name="PlayPauseButton" Command="{x:Bind Player.PlayPauseCommand}"
                                Width="40" Height="40" Padding="0" CornerRadius="20">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16"/>
                        </Button>
                        <Button Command="{x:Bind Player.NextCommand}"
                                Width="36" Height="36" Padding="0"
                                Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE893;" FontSize="14"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{x:Bind Player.PositionText, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" Width="36" TextAlignment="Right" Margin="0,0,4,0"/>
                        <Slider Minimum="0"
                                Maximum="{x:Bind Player.Duration, Mode=OneWay}"
                                Value="{x:Bind Player.Position, Mode=OneWay}"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                MinWidth="200"/>
                        <TextBlock Text="{x:Bind Player.DurationText, Mode=OneWay}"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" Width="36" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Margin="16,0,0,0">
                    <FontIcon Glyph="&#xE767;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <Slider Width="100" Minimum="0" Maximum="1" StepFrequency="0.01"
                            Value="{x:Bind Player.Volume, Mode=TwoWay}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
