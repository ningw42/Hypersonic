<Page
    x:Class="Hypersonic.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Hypersonic.Controls"
    xmlns:helpers="using:Hypersonic.Helpers"
    mc:Ignorable="d"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    xmlns:behaviors="using:Hypersonic.Behaviors">

    <Grid x:Name="ContentArea" PointerMoved="ContentArea_PointerMoved">
        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{x:Bind ViewModel.HasAnyContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Padding="0,0,16,24">

                <!-- Random Picks -->
                <StackPanel x:Name="RandomPicksSection"
                            Background="Transparent"
                            PointerEntered="RandomPicksSection_PointerEntered"
                            PointerExited="RandomPicksSection_PointerExited"
                            Visibility="{x:Bind ViewModel.HasRandomPicks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <TextBlock x:Uid="Home_RandomPicks"
                                   Text="Random Picks"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ShuffleRandomPicksButton"
                                Command="{x:Bind ViewModel.RefreshRandomPicksCommand}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="8,0,0,0"
                                CornerRadius="16"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Opacity="0"
                                IsHitTestVisible="False"
                                GotFocus="ShuffleRandomPicksButton_GotFocus"
                                LostFocus="ShuffleRandomPicksButton_LostFocus"
                                ToolTipService.ToolTip="Shuffle">
                            <Button.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15"/>
                            </Button.OpacityTransition>
                            <Grid>
                                <FontIcon Glyph="&#xE72C;"
                                          FontSize="14"
                                          Visibility="{x:Bind ViewModel.IsRefreshingRandomPicks, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                <ProgressRing Width="14"
                                              Height="14"
                                              IsActive="{x:Bind ViewModel.IsRefreshingRandomPicks, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsRefreshingRandomPicks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <controls:CoverflowControl x:Name="RandomPicksCoverflow"
                                               ItemsSource="{x:Bind ViewModel.RandomPicks, Mode=OneWay}"
                                               SelectedIndex="9"
                                               ItemWidth="240"
                                               ItemSpacing="-180"
                                               HoverRotationXDegrees="5"
                                               HoverRotationYDegrees="6"
                                               PressedScale="0.96"
                                               PressInDurationMilliseconds="70"
                                               PressOutDurationMilliseconds="120"
                                               Height="280"
                                               ItemInvoked="RandomPicksCoverflow_ItemInvoked">
                        <!-- Negative spacing intentionally overlaps side covers under the centered cover. -->
                        <controls:CoverflowControl.ItemTemplate>
                            <DataTemplate>
                                <controls:SquarePanel>
                                    <Grid CornerRadius="10">
                                        <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                        <Image helpers:CachedImage.Reference="{Binding CoverImage}"
                                               helpers:CachedImage.Size="300"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Grid>
                                </controls:SquarePanel>
                            </DataTemplate>
                        </controls:CoverflowControl.ItemTemplate>
                    </controls:CoverflowControl>
                    <StackPanel x:Name="CoverflowMetadataPanel"
                                DataContext="{Binding SelectedItem, ElementName=RandomPicksCoverflow}"
                                HorizontalAlignment="Center"
                                MaxWidth="520"
                                Margin="0,-2,0,0">
                        <RichTextBlock x:Name="CoverflowAlbumTitleText"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       IsTextSelectionEnabled="False"
                                       DataContextChanged="CoverflowAlbumTitle_DataContextChanged"/>
                        <RichTextBlock x:Name="CoverflowAlbumArtistText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       IsTextSelectionEnabled="False"
                                       Margin="0,2,0,0"
                                       DataContextChanged="AlbumArtistLinks_DataContextChanged"/>
                        <TextBlock Text="{Binding SelectedItem.Year, ElementName=RandomPicksCoverflow}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Recently Played -->
                <StackPanel Visibility="{x:Bind ViewModel.HasRecentlyPlayed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock x:Uid="Home_RecentlyPlayed"
                               Text="Recently Played"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,24,0,12"/>
                    <controls:CarouselPanel>
                        <ItemsRepeater x:Name="RecentlyPlayedRepeater"
                                       ItemsSource="{x:Bind ViewModel.RecentlyPlayed, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="AlbumCard_Click"
                                            Width="180"
                                            Padding="4"
                                            BorderThickness="0"
                                            CornerRadius="12"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Style="{StaticResource SubtleButtonStyle}">
                                        <Button.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.ThemeDictionaries>
                                                    <ResourceDictionary x:Key="Light">
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1A000000"/>
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25000000"/>
                                                    </ResourceDictionary>
                                                    <ResourceDictionary x:Key="Dark">
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1AFFFFFF"/>
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25FFFFFF"/>
                                                    </ResourceDictionary>
                                                </ResourceDictionary.ThemeDictionaries>
                                            </ResourceDictionary>
                                        </Button.Resources>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <controls:SquarePanel Grid.Row="0">
                                                    <Grid CornerRadius="8,8,0,0">
                                                        <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                                        <FontIcon Glyph="&#xE8D6;"
                                                                  FontSize="48"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        <Image helpers:CachedImage.Reference="{Binding CoverImage}"
                                                               helpers:CachedImage.Size="300"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    </Grid>
                                                </controls:SquarePanel>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"
                                                           ToolTipService.ToolTip="{Binding DisplayName}"
                                                           Margin="12,8,12,2"/>
                                                <RichTextBlock Grid.Row="2"
                                                               Margin="12,0,12,2"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1"
                                                               IsTextSelectionEnabled="False"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               DataContextChanged="AlbumArtistLinks_DataContextChanged"/>
                                                <TextBlock Grid.Row="3"
                                                           Text="{Binding Year}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           FontSize="12"
                                                           Margin="12,0,12,12"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </controls:CarouselPanel>
                </StackPanel>

                <!-- Recently Released -->
                <StackPanel Visibility="{x:Bind ViewModel.HasRecentlyReleased, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock x:Uid="Home_RecentlyReleased"
                               Text="Recently Released"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,24,0,12"/>
                    <controls:CarouselPanel>
                        <ItemsRepeater x:Name="RecentlyReleasedRepeater"
                                       ItemsSource="{x:Bind ViewModel.RecentlyReleased, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="AlbumCard_Click"
                                            Width="180"
                                            Padding="4"
                                            BorderThickness="0"
                                            CornerRadius="12"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Style="{StaticResource SubtleButtonStyle}">
                                        <Button.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.ThemeDictionaries>
                                                    <ResourceDictionary x:Key="Light">
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1A000000"/>
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25000000"/>
                                                    </ResourceDictionary>
                                                    <ResourceDictionary x:Key="Dark">
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1AFFFFFF"/>
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25FFFFFF"/>
                                                    </ResourceDictionary>
                                                </ResourceDictionary.ThemeDictionaries>
                                            </ResourceDictionary>
                                        </Button.Resources>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <controls:SquarePanel Grid.Row="0">
                                                    <Grid CornerRadius="8,8,0,0">
                                                        <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                                        <FontIcon Glyph="&#xE8D6;"
                                                                  FontSize="48"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        <Image helpers:CachedImage.Reference="{Binding CoverImage}"
                                                               helpers:CachedImage.Size="300"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    </Grid>
                                                </controls:SquarePanel>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"
                                                           ToolTipService.ToolTip="{Binding DisplayName}"
                                                           Margin="12,8,12,2"/>
                                                <RichTextBlock Grid.Row="2"
                                                               Margin="12,0,12,2"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1"
                                                               IsTextSelectionEnabled="False"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               DataContextChanged="AlbumArtistLinks_DataContextChanged"/>
                                                <TextBlock Grid.Row="3"
                                                           Text="{Binding Year}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           FontSize="12"
                                                           Margin="12,0,12,12"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </controls:CarouselPanel>
                </StackPanel>

                <!-- Recently Added -->
                <StackPanel Visibility="{x:Bind ViewModel.HasRecentlyAdded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock x:Uid="Home_RecentlyAdded"
                               Text="Recently Added"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,24,0,12"/>
                    <controls:CarouselPanel>
                        <ItemsRepeater x:Name="RecentlyAddedRepeater"
                                       ItemsSource="{x:Bind ViewModel.RecentlyAdded, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="AlbumCard_Click"
                                            Width="180"
                                            Padding="4"
                                            BorderThickness="0"
                                            CornerRadius="12"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Style="{StaticResource SubtleButtonStyle}">
                                        <Button.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.ThemeDictionaries>
                                                    <ResourceDictionary x:Key="Light">
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1A000000"/>
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25000000"/>
                                                    </ResourceDictionary>
                                                    <ResourceDictionary x:Key="Dark">
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1AFFFFFF"/>
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25FFFFFF"/>
                                                    </ResourceDictionary>
                                                </ResourceDictionary.ThemeDictionaries>
                                            </ResourceDictionary>
                                        </Button.Resources>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <controls:SquarePanel Grid.Row="0">
                                                    <Grid CornerRadius="8,8,0,0">
                                                        <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                                        <FontIcon Glyph="&#xE8D6;"
                                                                  FontSize="48"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        <Image helpers:CachedImage.Reference="{Binding CoverImage}"
                                                               helpers:CachedImage.Size="300"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    </Grid>
                                                </controls:SquarePanel>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"
                                                           ToolTipService.ToolTip="{Binding DisplayName}"
                                                           Margin="12,8,12,2"/>
                                                <RichTextBlock Grid.Row="2"
                                                               Margin="12,0,12,2"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1"
                                                               IsTextSelectionEnabled="False"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               DataContextChanged="AlbumArtistLinks_DataContextChanged"/>
                                                <TextBlock Grid.Row="3"
                                                           Text="{Binding Year}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           FontSize="12"
                                                           Margin="12,0,12,12"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </controls:CarouselPanel>
                </StackPanel>

                <!-- Most Played -->
                <StackPanel Visibility="{x:Bind ViewModel.HasMostPlayed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock x:Uid="Home_MostPlayed"
                               Text="Most Played"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               Margin="0,24,0,12"/>
                    <controls:CarouselPanel>
                        <ItemsRepeater x:Name="MostPlayedRepeater"
                                       ItemsSource="{x:Bind ViewModel.MostPlayed, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="8"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="AlbumCard_Click"
                                            Width="180"
                                            Padding="4"
                                            BorderThickness="0"
                                            CornerRadius="12"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Style="{StaticResource SubtleButtonStyle}">
                                        <Button.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.ThemeDictionaries>
                                                    <ResourceDictionary x:Key="Light">
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1A000000"/>
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25000000"/>
                                                    </ResourceDictionary>
                                                    <ResourceDictionary x:Key="Dark">
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1AFFFFFF"/>
                                                        <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25FFFFFF"/>
                                                    </ResourceDictionary>
                                                </ResourceDictionary.ThemeDictionaries>
                                            </ResourceDictionary>
                                        </Button.Resources>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <controls:SquarePanel Grid.Row="0">
                                                    <Grid CornerRadius="8,8,0,0">
                                                        <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                                        <FontIcon Glyph="&#xE8D6;"
                                                                  FontSize="48"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        <Image helpers:CachedImage.Reference="{Binding CoverImage}"
                                                               helpers:CachedImage.Size="300"
                                                               Stretch="UniformToFill"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    </Grid>
                                                </controls:SquarePanel>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"
                                                           ToolTipService.ToolTip="{Binding DisplayName}"
                                                           Margin="12,8,12,2"/>
                                                <RichTextBlock Grid.Row="2"
                                                               Margin="12,0,12,2"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1"
                                                               IsTextSelectionEnabled="False"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               DataContextChanged="AlbumArtistLinks_DataContextChanged"/>
                                                <TextBlock Grid.Row="3"
                                                           Text="{Binding Year}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           FontSize="12"
                                                           Margin="12,0,12,12"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </controls:CarouselPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading indicator -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="40" Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Error state -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock x:Uid="Home_Error"
                       Text="Couldn't load your library — check your connection and try again"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,16"/>
            <Button x:Uid="Home_Retry"
                    Content="Retry"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Empty state (all sections empty but no errors) -->
        <TextBlock x:Uid="Home_Empty"
                   Text="Your library is waiting — start playing some music!"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Brush providers for code-behind hyperlink rendering -->
        <TextBlock x:Name="PrimaryBrushProvider" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed"/>
        <TextBlock x:Name="SecondaryBrushProvider" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
        <TextBlock x:Name="TertiaryBrushProvider" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed"/>
    </Grid>
</Page>
