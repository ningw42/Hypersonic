<Page
    x:Class="Hypersonic.Views.NowPlayingPage"
    x:Name="NowPlayingPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Hypersonic.Models"
    xmlns:vm="using:Hypersonic.ViewModels"
    xmlns:converters="using:Hypersonic.Converters"
    xmlns:behaviors="using:Hypersonic.Behaviors"
    xmlns:controls="using:Hypersonic.Controls"
    xmlns:helpers="using:Hypersonic.Helpers"
    mc:Ignorable="d"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never">

    <Page.Resources>
        <converters:SecondsToTimeConverter x:Key="SecondsToTimeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:LyricsLoadStateToVisibilityConverter x:Key="LyricsLoadStateToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Page.Resources>

    <Grid x:Name="RootContentGrid" Padding="32,16,32,16" ColumnSpacing="64" SizeChanged="RootContentGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column: art + metadata -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="16">
            <!--
                SquarePanel enforces a 1:1 aspect ratio against the available width
                from its parent column. MaxWidth caps it on wide windows; on narrow
                windows it shrinks with the column instead of overflowing into the
                tab surface (design "Sizing" section + smoke test #15).
                The outer StackPanel must be Stretch (not Center) for SquarePanel
                to receive the full column width during measure.
            -->
            <Grid x:Name="LargeCoverArtClip" HorizontalAlignment="Center" SizeChanged="LargeCoverArtClip_SizeChanged">
                <controls:SquarePanel x:Name="LargeCoverArtSquarePanel" HorizontalAlignment="Center" MaxWidth="600" MaxHeight="600">
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8"
                            Visibility="{x:Bind Player.HasCoverArt, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="96"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Grid x:Name="LargeCoverArtContainer">
                        <Grid x:Name="LargeCoverArtOutgoingWrapper" CornerRadius="8" Opacity="0" IsHitTestVisible="False">
                            <Image x:Name="LargeCoverArtOutgoing" Stretch="UniformToFill"/>
                        </Grid>
                        <Grid x:Name="LargeCoverArtWrapper" CornerRadius="8">
                            <Image x:Name="LargeCoverArt" Stretch="UniformToFill"/>
                        </Grid>
                    </Grid>
                </controls:SquarePanel>
            </Grid>

            <StackPanel x:Name="MetadataStack" HorizontalAlignment="Center" Spacing="2" MaxWidth="500" SizeChanged="MetadataStack_SizeChanged">
                <RichTextBlock x:Name="MetaTrackTitle"
                               IsHitTestVisible="{x:Bind Player.HasTrack, Mode=OneWay}"
                               IsTextSelectionEnabled="False"
                               FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                               FontSize="24"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2">
                    <Paragraph>
                        <Hyperlink x:Name="MetaTrackTitleLink"
                                   UnderlineStyle="None"
                                   Click="MetaTrackTitleLink_Click">
                            <!-- Foreground is set in code-behind on the Hyperlink, not the Run, so theme refreshes keep native hover styling. -->
                            <Run Text="{x:Bind Player.TrackTitle, Mode=OneWay}"
                                 FontSize="24" FontWeight="SemiBold"/>
                        </Hyperlink>
                    </Paragraph>
                </RichTextBlock>
                <RichTextBlock x:Name="MetaArtistText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               IsTextSelectionEnabled="False"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               FontSize="14"/>
                <RichTextBlock x:Name="MetaAlbumText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               IsTextSelectionEnabled="False"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               FontSize="13"/>
                <TextBlock Text="{x:Bind ViewModel.TechnicalDetail, Mode=OneWay}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.TechnicalDetail, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Favorite — reuses the player-bar VM state so the two hearts stay in lockstep. -->
                <Button HorizontalAlignment="Center" Margin="0,8,0,0"
                        Command="{x:Bind Player.ToggleStarCommand}"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        Style="{StaticResource TransparentButtonStyle}"
                        Width="40" Height="40"
                        ToolTipService.ToolTip="Favorite">
                    <FontIcon FontSize="18"
                              Glyph="{x:Bind Player.IsStarred, Mode=OneWay,
                                      Converter={StaticResource BoolToGlyphConverter},
                                      ConverterParameter='&#xEB52;|&#xEB51;'}"
                              Foreground="{x:Bind Player.IsStarred, Mode=OneWay,
                                      Converter={StaticResource BoolToFavoriteBrushConverter}}"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Right column: tabs -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <SelectorBar x:Name="TabSelectorBar" Grid.Row="0" Margin="0,0,0,12"
                         HorizontalAlignment="Center"
                         SelectionChanged="TabSelectorBar_SelectionChanged">
                <SelectorBarItem x:Name="LyricsTab" Text="Lyrics" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xED1E;"/>
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="QueueTab" Text="Queue">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8FD;"/>
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <!-- Lyrics surface -->
            <Grid Grid.Row="1" x:Name="LyricsSurface">
                <ProgressRing IsActive="True" Width="32" Height="32"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{x:Bind ViewModel.LyricsLoadState, Mode=OneWay, Converter={StaticResource LyricsLoadStateToVisibilityConverter}, ConverterParameter=Loading}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.LyricsLoadState, Mode=OneWay, Converter={StaticResource LyricsLoadStateToVisibilityConverter}, ConverterParameter=Loaded}"
                              Padding="0,0,16,0">
                    <TextBlock Text="{x:Bind ViewModel.LyricsText, Mode=OneWay}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               LineHeight="22"
                               MaxWidth="600"
                               Padding="0,8,0,16"/>
                </ScrollViewer>

                <TextBlock Text="No lyrics available"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="13"
                           Visibility="{x:Bind ViewModel.LyricsLoadState, Mode=OneWay, Converter={StaticResource LyricsLoadStateToVisibilityConverter}, ConverterParameter=NoLyrics}"/>
            </Grid>

            <!-- Queue surface -->
            <Grid Grid.Row="1" x:Name="QueueSurface" Visibility="Collapsed">
                <ListView x:Name="QueueListView"
                          ItemsSource="{x:Bind Player.QueueItems, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          DoubleTapped="QueueList_DoubleTapped"
                          Padding="0,0,16,16"
                          Visibility="{x:Bind Player.IsQueueEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueItem">
                            <Grid Padding="8,6" ColumnSpacing="12" Height="56"
                                  CornerRadius="4"
                                  Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToHighlightBrushConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="48" Height="48" CornerRadius="2">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="2">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="18"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Image helpers:CachedImage.Reference="{x:Bind Track.CoverImage, Mode=OneWay}"
                                           helpers:CachedImage.Size="100"
                                           Stretch="UniformToFill"
                                           Width="48" Height="48"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="{x:Bind Track.Title}" FontSize="14" MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToFontWeightConverter}}"/>
                                    <TextBlock Text="{x:Bind Track.FlatArtistText}" FontSize="12" MaxLines="1"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Track.Album}"
                                           FontSize="13" MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Track.Duration, Converter={StaticResource SecondsToTimeConverter}}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"/>

                                <!-- Favorite (PlaybackTrack.IsStarred notifies; Mode=OneWay is required) -->
                                <ToggleButton Grid.Column="4"
                                              IsChecked="{x:Bind Track.IsStarred, Mode=OneWay}"
                                              Padding="0" Width="32" Height="32" Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              BorderThickness="0" Background="Transparent"
                                              Style="{StaticResource FavoriteToggleButtonStyle}"
                                              Command="{Binding Player.ToggleQueueItemStarCommand, ElementName=NowPlayingPageRoot}"
                                              CommandParameter="{x:Bind}"
                                              ToolTipService.ToolTip="Favorite"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Queue is empty"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="13"
                           Visibility="{x:Bind Player.IsQueueEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Grid>

        <!-- Brush providers -->
        <TextBlock x:Name="PrimaryBrushProvider" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed"/>
        <TextBlock x:Name="SecondaryBrushProvider" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
        <TextBlock x:Name="TertiaryBrushProvider" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed"/>
    </Grid>
</Page>
