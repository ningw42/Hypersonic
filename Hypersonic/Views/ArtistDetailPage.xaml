<Page
    x:Class="Hypersonic.Views.ArtistDetailPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="using:Hypersonic.Behaviors"
    xmlns:controls="using:Hypersonic.Controls"
    mc:Ignorable="d"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,24">

                <!-- Artist header -->
                <Grid Margin="0,0,0,24" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Artist photo (circular) -->
                    <Grid Grid.Column="0"
                          Width="200" Height="200"
                          CornerRadius="100">
                        <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                   RadiusX="100" RadiusY="100"/>
                        <FontIcon Glyph="&#xE77B;"
                                  FontSize="48"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        <Image Source="{Binding ViewModel.ArtistImageUrl, ElementName=PageRoot}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Metadata -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                                   Style="{StaticResource HeaderTextBlockStyle}"
                                   FontWeight="Bold"
                                   TextWrapping="WrapWholeWords"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.AlbumCountText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="&#x00B7;"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalSongCountText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Error message -->
                <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                         Severity="Error"
                         x:Uid="ArtistDetail_Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         Margin="0,0,0,8"/>

                <!-- Biography section -->
                <StackPanel Visibility="{x:Bind ViewModel.HasBiography, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,0,24">
                    <TextBlock Text="{x:Bind ViewModel.Biography, Mode=OneWay}"
                               TextWrapping="Wrap"
                               MaxLines="{x:Bind ViewModel.BiographyMaxLines, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <HyperlinkButton Command="{x:Bind ViewModel.ToggleBiographyCommand}"
                                     Padding="0"
                                     Margin="0,4,0,0">
                        <TextBlock Text="{x:Bind ViewModel.BiographyToggleText, Mode=OneWay}"/>
                    </HyperlinkButton>
                </StackPanel>

                <!-- Discography section header -->
                <Grid Margin="0,0,0,8"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Uid="ArtistDetail_Discography"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{x:Bind ViewModel.SortOptions}"
                              SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              MinWidth="150"/>

                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.ToggleSortOrderCommand}"
                            VerticalAlignment="Center"
                            Width="32" Height="32" Padding="0"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SortOrderTooltip, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.SortOrderGlyph, Mode=OneWay}" FontSize="16"/>
                    </Button>
                </Grid>

                <!-- Discography album grid -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="200"
                                           MinColumnSpacing="0"
                                           MinRowSpacing="0"
                                           ItemsStretch="Fill"
                                           ItemsJustification="Start"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button Click="AlbumCard_Click"
                                    Padding="4"
                                    BorderThickness="0"
                                    CornerRadius="12"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <Button.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1A000000"/>
                                                <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25000000"/>
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Dark">
                                                <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1AFFFFFF"/>
                                                <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25FFFFFF"/>
                                            </ResourceDictionary>
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </Button.Resources>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Album cover art -->
                                        <controls:SquarePanel Grid.Row="0">
                                            <Grid CornerRadius="8,8,0,0">
                                                <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                                <FontIcon Glyph="&#xE8D6;"
                                                          FontSize="48"
                                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                <Image Source="{Binding CoverArtUrl}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            </Grid>
                                        </controls:SquarePanel>

                                        <!-- Album name -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   ToolTipService.ToolTip="{Binding Name}"
                                                   Margin="12,8,12,2"/>

                                        <!-- Artist name -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Artist}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   ToolTipService.ToolTip="{Binding Artist}"
                                                   Margin="12,0,12,2"/>

                                        <!-- Year -->
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding Year}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   FontSize="12"
                                                   Margin="12,0,12,12"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Similar Artists section header -->
                <TextBlock x:Uid="ArtistDetail_SimilarArtists"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,24,0,8"
                           Visibility="{x:Bind ViewModel.HasSimilarArtists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Similar Artists horizontal list -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind ViewModel.HasSimilarArtists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SimilarArtists, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="0"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button Click="SimilarArtistCard_Click"
                                        Width="180"
                                        Padding="4"
                                        BorderThickness="0"
                                        CornerRadius="12"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Style="{StaticResource SubtleButtonStyle}">
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Light">
                                                    <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1A000000"/>
                                                    <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25000000"/>
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Dark">
                                                    <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1AFFFFFF"/>
                                                    <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25FFFFFF"/>
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Artist cover art -->
                                            <controls:SquarePanel Grid.Row="0">
                                                <Grid CornerRadius="8,8,0,0">
                                                    <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                                    <FontIcon Glyph="&#xE77B;"
                                                              FontSize="48"
                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                    <Image Source="{Binding CoverArtUrl}"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                </Grid>
                                            </controls:SquarePanel>

                                            <!-- Artist name -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1"
                                                       ToolTipService.ToolTip="{Binding Name}"
                                                       Margin="12,8,12,2"/>

                                            <!-- Album count -->
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding AlbumCountText}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       FontSize="12"
                                                       Margin="12,0,12,12"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading indicator -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="40" Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Page>
