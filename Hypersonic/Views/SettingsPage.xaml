<Page
    x:Class="Hypersonic.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:hcontrols="using:Hypersonic.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:Hypersonic.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <!-- Kill the 8px reserved Header area at the top of TokenizingTextBox.
             Default TextBoxTopHeaderMargin is "0,0,0,8" so even with no Header
             content the inner Header ContentPresenter measures 8px tall and
             pushes the visible input down. Our font pickers don't use Header,
             so we want zero. Scoped to this Page; SettingsPage has no other
             TextBox-derived controls, so no collateral effect. -->
        <Thickness x:Key="TextBoxTopHeaderMargin">0</Thickness>
    </Page.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentArea" Padding="0,0,16,24">

            <!-- General -->
            <TextBlock x:Uid="Settings_General" Style="{ThemeResource SubtitleTextBlockStyle}" />

            <controls:SettingsCard x:Uid="Settings_MinimizeToTray"
                                   Margin="{StaticResource XSmallTopMargin}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE921;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="Settings_CloseToTray">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8BB;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!-- Personalization -->
            <TextBlock x:Uid="Settings_Personalization"
                       Margin="{StaticResource MediumTopMargin}"
                       Style="{ThemeResource SubtitleTextBlockStyle}" />

            <controls:SettingsCard
                x:Uid="Settings_Theme"
                Margin="{StaticResource XSmallTopMargin}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:Segmented SelectedIndex="{x:Bind ViewModel.ElementThemeIndex, Mode=TwoWay}">
                    <controls:SegmentedItem x:Uid="Settings_Theme_Light" />
                    <controls:SegmentedItem x:Uid="Settings_Theme_Dark" />
                    <controls:SegmentedItem x:Uid="Settings_Theme_Default" />
                </controls:Segmented>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="Settings_Backdrop">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:Segmented SelectedIndex="{x:Bind ViewModel.BackdropTypeIndex, Mode=TwoWay}">
                    <controls:SegmentedItem x:Uid="Settings_Backdrop_Mica" />
                    <controls:SegmentedItem x:Uid="Settings_Backdrop_MicaAlt" />
                    <controls:SegmentedItem x:Uid="Settings_Backdrop_Acrylic" />
                    <controls:SegmentedItem x:Uid="Settings_Backdrop_None" />
                </controls:Segmented>
            </controls:SettingsCard>

            <!-- Fonts (UI + Lyrics + UI scale). Persisted only — currently inert
                 until a follow-up change wires the values into resource dictionaries
                 and visual element overrides. -->
            <controls:SettingsExpander
                x:Uid="Settings_Fonts"
                IsExpanded="False"
                IsEnabled="{x:Bind ViewModel.IsFontSettingsInitialized, Mode=OneWay}">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8D2;" />
                </controls:SettingsExpander.HeaderIcon>
                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnRestartAppClicked"
                    Visibility="{x:Bind ViewModel.IsFontRestartRequired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock x:Uid="Settings_FontsRestartButtonText"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        x:Uid="Settings_UiFonts"
                        ContentAlignment="Vertical">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <controls:TokenizingTextBox
                                Grid.Column="0"
                                x:Name="UiFontPicker"
                                ItemsSource="{x:Bind ViewModel.UiFontFamilies, Mode=OneWay}"
                                SuggestedItemsSource="{x:Bind UiFontSuggestions, Mode=OneWay}"
                                x:Uid="Settings_FontPicker"
                                TokenDelimiter=","
                                TextChanged="OnUiFontTextChanged"
                                TokenItemAdding="OnFontTokenAdding">
                                <controls:TokenizingTextBox.QueryIcon>
                                    <FontIconSource
                                        Glyph="&#xE721;"
                                        FontSize="12" />
                                </controls:TokenizingTextBox.QueryIcon>
                                <controls:TokenizingTextBox.TokenItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="{x:Bind}" />
                                    </DataTemplate>
                                </controls:TokenizingTextBox.TokenItemTemplate>
                                <controls:TokenizingTextBox.SuggestedItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="{x:Bind}" />
                                    </DataTemplate>
                                </controls:TokenizingTextBox.SuggestedItemTemplate>
                            </controls:TokenizingTextBox>
                            <Button
                                Grid.Column="1"
                                x:Name="ResetUiFontsButton"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.ResetUiFontsCommand}"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Right"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                MinHeight="0"
                                MinWidth="32"
                                Width="32"
                                Padding="0">
                                <FontIcon
                                    Glyph="&#xE777;"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Uid="Settings_LyricsFonts"
                        ContentAlignment="Vertical">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <controls:TokenizingTextBox
                                Grid.Column="0"
                                x:Name="LyricsFontPicker"
                                ItemsSource="{x:Bind ViewModel.LyricsFontFamilies, Mode=OneWay}"
                                SuggestedItemsSource="{x:Bind LyricsFontSuggestions, Mode=OneWay}"
                                x:Uid="Settings_FontPicker"
                                TokenDelimiter=","
                                TextChanged="OnLyricsFontTextChanged"
                                TokenItemAdding="OnFontTokenAdding">
                                <controls:TokenizingTextBox.QueryIcon>
                                    <FontIconSource
                                        Glyph="&#xE721;"
                                        FontSize="12" />
                                </controls:TokenizingTextBox.QueryIcon>
                                <controls:TokenizingTextBox.TokenItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="{x:Bind}" />
                                    </DataTemplate>
                                </controls:TokenizingTextBox.TokenItemTemplate>
                                <controls:TokenizingTextBox.SuggestedItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="{x:Bind}" />
                                    </DataTemplate>
                                </controls:TokenizingTextBox.SuggestedItemTemplate>
                            </controls:TokenizingTextBox>
                            <Button
                                Grid.Column="1"
                                x:Name="ResetLyricsFontsButton"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.ResetLyricsFontsCommand}"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Right"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                MinHeight="0"
                                MinWidth="32"
                                Width="32"
                                Padding="0">
                                <FontIcon
                                    Glyph="&#xE777;"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="Settings_UiScale">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:Segmented SelectedIndex="{x:Bind ViewModel.UiScaleIndex, Mode=TwoWay}">
                                <controls:SegmentedItem Content="90%" />
                                <controls:SegmentedItem Content="100%" />
                                <controls:SegmentedItem Content="115%" />
                                <controls:SegmentedItem Content="125%" />
                                <controls:SegmentedItem Content="150%" />
                            </controls:Segmented>
                            <Button
                                x:Name="ResetUiScaleButton"
                                Style="{ThemeResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.ResetUiScaleCommand}"
                                MinWidth="32"
                                Width="32"
                                Height="32"
                                Padding="0">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Lyrics -->
            <TextBlock x:Uid="Settings_Lyrics"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Margin="{StaticResource MediumTopMargin}" />

            <controls:SettingsExpander
                x:Uid="Settings_LyricsExpander"
                Margin="{StaticResource XSmallTopMargin}"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8D6;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        x:Uid="Settings_LyricsProvidersCard"
                        ContentAlignment="Vertical">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <hcontrols:ReorderableTokenizingTextBox
                        Grid.Column="0"
                        x:Name="LyricsProviderBox"
                        x:Uid="Settings_LyricsProviderPicker"
                        TokenDelimiter=","
                        TokenSpacing="2"
                        ItemsSource="{x:Bind LyricsViewModel.EnabledProviders, Mode=OneWay}"
                        ReorderItemsSource="{x:Bind LyricsViewModel.EnabledProviders, Mode=OneWay}"
                        SuggestedItemsSource="{x:Bind LyricsViewModel.ProviderSuggestions, Mode=OneWay}"
                        TextMemberPath="DisplayName"
                        TextChanged="OnLyricsProviderTextChanged"
                        TokenItemAdding="OnLyricsProviderTokenAdding"
                        TokenItemAdded="OnLyricsProviderTokenAdded"
                        TokenItemRemoving="OnLyricsProviderTokenRemoving"
                        TokenItemRemoved="OnLyricsProviderTokenRemoved"
                        ItemsReordered="OnLyricsProviderItemsReordered">
                        <hcontrols:ReorderableTokenizingTextBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel
                                    ui:FrameworkElementExtensions.AncestorType="hcontrols:ReorderableTokenizingTextBox"
                                    HorizontalSpacing="{Binding (ui:FrameworkElementExtensions.Ancestor).TokenSpacing, RelativeSource={RelativeSource Self}}"
                                    StretchChild="Last"
                                    VerticalSpacing="{Binding (ui:FrameworkElementExtensions.Ancestor).TokenSpacing, RelativeSource={RelativeSource Self}}" />
                            </ItemsPanelTemplate>
                        </hcontrols:ReorderableTokenizingTextBox.ItemsPanel>
                        <hcontrols:ReorderableTokenizingTextBox.QueryIcon>
                            <FontIconSource Glyph="&#xE721;" FontSize="12" />
                        </hcontrols:ReorderableTokenizingTextBox.QueryIcon>
                        <hcontrols:ReorderableTokenizingTextBox.TokenItemTemplate>
                            <DataTemplate x:DataType="vm:LyricsProviderItem">
                                <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </hcontrols:ReorderableTokenizingTextBox.TokenItemTemplate>
                        <hcontrols:ReorderableTokenizingTextBox.SuggestedItemTemplate>
                            <DataTemplate x:DataType="vm:LyricsProviderItem">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </hcontrols:ReorderableTokenizingTextBox.SuggestedItemTemplate>
                    </hcontrols:ReorderableTokenizingTextBox>

                    <Button
                        Grid.Column="1"
                        x:Name="ResetLyricsProvidersButton"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Command="{x:Bind LyricsViewModel.ResetProvidersCommand}"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        MinHeight="0"
                        MinWidth="32"
                        Width="32"
                        Height="32"
                        Padding="0">
                        <FontIcon Glyph="&#xE777;" FontSize="14" />
                    </Button>
                </Grid>
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Uid="Settings_LyricsAutoLoadCard"
                Description="{x:Bind LyricsViewModel.AutoLoadText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider Minimum="0.3" Maximum="3.0" StepFrequency="0.1"
                            Value="{x:Bind LyricsViewModel.AutoLoadSeconds, Mode=TwoWay}"
                            Width="200" />
                    <Button
                        x:Name="ResetLyricsAutoLoadButton"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Command="{x:Bind LyricsViewModel.ResetAutoLoadCommand}"
                        MinWidth="32" Width="32" Height="32" Padding="0">
                        <FontIcon Glyph="&#xE777;" FontSize="14" />
                    </Button>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Uid="Settings_LyricsManualRefreshCard"
                Description="{x:Bind LyricsViewModel.ManualRefreshText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider Minimum="1.0" Maximum="15.0" StepFrequency="0.5"
                            Value="{x:Bind LyricsViewModel.ManualRefreshSeconds, Mode=TwoWay}"
                            Width="200" />
                    <Button
                        x:Name="ResetLyricsManualRefreshButton"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Command="{x:Bind LyricsViewModel.ResetManualRefreshCommand}"
                        MinWidth="32" Width="32" Height="32" Padding="0">
                        <FontIcon Glyph="&#xE777;" FontSize="14" />
                    </Button>
                </StackPanel>
            </controls:SettingsCard>

                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Scrobbling -->
            <TextBlock x:Uid="Settings_Scrobbling"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Margin="{StaticResource MediumTopMargin}" />

            <controls:SettingsExpander
                x:Uid="Settings_ScrobblingExpander"
                Margin="{StaticResource SmallTopBottomMargin}"
                IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xF739;" />
                </controls:SettingsExpander.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsScrobblingEnabled, Mode=TwoWay}" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        x:Uid="Settings_NowPlayingCard"
                        IsEnabled="{x:Bind ViewModel.IsScrobblingEnabled, Mode=OneWay}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsNowPlayingEnabled, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Uid="Settings_PlaytimeThresholdCard"
                        IsEnabled="{x:Bind ViewModel.IsScrobblingEnabled, Mode=OneWay}">
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.PlaytimePresets}"
                            SelectedValue="{x:Bind ViewModel.SelectedPlaytimeThreshold, Mode=TwoWay}"
                            SelectedValuePath="Seconds"
                            DisplayMemberPath="Display" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Uid="Settings_PercentageThresholdCard"
                        IsEnabled="{x:Bind ViewModel.IsScrobblingEnabled, Mode=OneWay}"
                        Description="{x:Bind ViewModel.PercentageThresholdText, Mode=OneWay}">
                        <Slider
                            Minimum="10"
                            Maximum="100"
                            StepFrequency="5"
                            Value="{x:Bind ViewModel.ScrobblePercentageThreshold, Mode=TwoWay}"
                            Width="200" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Uid="Settings_ConditionModeCard"
                        IsEnabled="{x:Bind ViewModel.IsScrobblingEnabled, Mode=OneWay}">
                        <controls:Segmented SelectedIndex="{x:Bind ViewModel.ScrobbleConditionModeIndex, Mode=TwoWay}">
                            <controls:SegmentedItem x:Uid="Settings_ConditionMode_Or" />
                            <controls:SegmentedItem x:Uid="Settings_ConditionMode_And" />
                        </controls:Segmented>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Storage -->
            <TextBlock x:Uid="Settings_Storage"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Margin="{StaticResource MediumTopMargin}" />

            <controls:SettingsCard
                x:Uid="Settings_ImageCache"
                Description="{x:Bind ViewModel.ImageCacheUsageText, Mode=OneWay}"
                Margin="{StaticResource XSmallTopMargin}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsImageCacheBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsImageCacheBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        x:Uid="Settings_ImageCache_Clear"
                        Command="{x:Bind ViewModel.ClearImageCacheCommand}"
                        IsEnabled="{x:Bind ViewModel.CanClearImageCache, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>

            <!-- About -->
            <TextBlock x:Uid="Settings_About"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Margin="{StaticResource MediumTopMargin}" />

            <controls:SettingsCard
                x:Uid="Settings_VersionCard"
                Margin="{StaticResource XSmallTopMargin}"
                Description="{x:Bind ViewModel.VersionDescription, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="Settings_PrivacyCard">
                <HyperlinkButton x:Uid="SettingsPage_PrivacyTermsLink" />
            </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
