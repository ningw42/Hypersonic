<Page
    x:Class="Hypersonic.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="using:Hypersonic.Behaviors"
    xmlns:controls="using:Hypersonic.Controls"
    xmlns:helpers="using:Hypersonic.Helpers"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Uid="Albums_Title"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{x:Bind ViewModel.SortOptions}"
                      SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      MinWidth="150"/>

            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.ToggleSortOrderCommand}"
                    IsEnabled="{x:Bind ViewModel.IsSortOrderSupported, Mode=OneWay}"
                    VerticalAlignment="Center"
                    Width="32" Height="32" Padding="0"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SortOrderTooltip, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind ViewModel.SortOrderGlyph, Mode=OneWay}" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Error message -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error"
                 x:Uid="Albums_Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 Margin="0,0,0,8"/>

        <!-- Albums grid -->
        <ScrollViewer Grid.Row="2"
                      x:Name="AlbumsScrollViewer"
                      ViewChanged="AlbumsScrollViewer_ViewChanged">
            <Border Padding="0,0,16,0">
            <ItemsRepeater x:Name="AlbumsRepeater" ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="200"
                                       MinColumnSpacing="0"
                                       MinRowSpacing="0"
                                       ItemsStretch="Fill"
                                       ItemsJustification="Start"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button Click="AlbumCard_Click"
                                Padding="4"
                                BorderThickness="0"
                                CornerRadius="12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Style="{StaticResource SubtleButtonStyle}">
                            <Button.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1A000000"/>
                                            <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25000000"/>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#1AFFFFFF"/>
                                            <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#25FFFFFF"/>
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </Button.Resources>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Album cover art (square via SquarePanel) -->
                                    <controls:SquarePanel Grid.Row="0">
                                        <Grid CornerRadius="8,8,0,0">
                                            <!-- Placeholder -->
                                            <Rectangle Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                            <FontIcon Glyph="&#xE8D6;"
                                                      FontSize="48"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            <!-- Actual cover art -->
                                            <Image helpers:CachedImage.Reference="{Binding CoverImage}"
                                                   helpers:CachedImage.Size="300"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Grid>
                                    </controls:SquarePanel>

                                    <!-- Album name -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               ToolTipService.ToolTip="{Binding DisplayName}"
                                               Margin="12,8,12,2"/>

                                    <!-- Artist name -->
                                    <RichTextBlock Grid.Row="2"
                                                   Margin="12,0,12,2"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   IsTextSelectionEnabled="False"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   DataContextChanged="AlbumArtistLinks_DataContextChanged"/>

                                    <!-- Year -->
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding Year}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               FontSize="12"
                                               Margin="12,0,12,12"/>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            </Border>
        </ScrollViewer>

        <!-- Loading indicator overlay -->
        <ProgressRing Grid.Row="2"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="40" Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <!-- Brush providers for code-behind artist rendering -->
        <TextBlock x:Name="SecondaryBrushProvider" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
        <TextBlock x:Name="TertiaryBrushProvider" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed"/>
    </Grid>
</Page>
